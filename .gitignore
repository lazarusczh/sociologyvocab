# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
.codebuddy/
.freebuff/

# 环境变量（含 Supabase 连接信息与密钥，不纳入公开备份）
.env
app/.env

# Excel 词库源文件（教师知识产权，不纳入公开备份）
*.xlsx

# 语境填空教学范文（含答案版，教师知识产权，不纳入公开备份）
A1*.docx

# 由 Excel 生成的内置词库数据（同属知识产权，不纳入公开备份）
app/public/vocab-data.json

# 预抓取的社会数据（结婚率/离婚率等，教师 IP，由 scripts/fetch-social-data.mjs 生成）
app/public/social-data.json

# 教师本地重置码工具与私钥（绝不纳入公开备份）
reset-tool/
teacher-private-key.json

# 教师课件与素材（PPT 打印版 PDF、提取文本等，属教师知识产权，不纳入公开备份）
A1 Paper*.pdf
A2 Paper*.pdf
pdf-text/
ppt-text/
pdf-libs/
unit-tags-backup/

# 打包生成的安装包（内含内置词库数据，属于教师知识产权，不纳入公开备份）
*.apk

# 设备相关的生成产物（Capacitor 在平板等具体设备上 sync 生成，文件名带设备名后缀）
**/*TABLET-*
app/package-TABLET-*.json
app/package-lock-TABLET-*.json
app/android/app/src/main/assets/

# 教师工具脚本（含飞书 open_id 等个人身份信息，不纳入公开备份）
app/scripts/send-apk.ps1

# 自动化诊断日志（本地临时产物）
@AutomationLog.txt

# 数据库备份文件（含业务数据，不纳入版本控制；已存于本地/OneDrive）
backups/

# 词库诊断/归并报告（含业务数据与归并建议，不纳入公开备份）
theory-diagnostic-report.md
theory-cleanup-list.md

# 流派/理论关系设计决策文件（教师教学设计与知识产权，不纳入公开备份）
流派设计决策.md

# UI 设计综合文件（教师产品设计想法与知识产权，不纳入公开备份）
UI设计.md