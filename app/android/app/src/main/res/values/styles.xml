<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 运行时主主题：Capacitor 的 BridgeActivity 会切到本主题。
         状态栏取顶栏色，与紧邻的顶栏完全同色。
         windowBackground 同样取顶栏色：Android 15+（targetSdk 35+）强制 edge-to-edge 时，
         系统栏区域由窗口背景填充，用它保证状态栏与顶栏不出现色差。
         导航栏设为透明（手势导航下内容自然延伸到底），并关掉系统强制对比度遮罩。 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <item name="android:windowBackground">@color/surfaceColor</item>
        <item name="android:statusBarColor">@color/surfaceColor</item>
        <!-- 手势导航栏透明 + 关闭系统强制对比度遮罩（API 29+） -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- 浅色底 → 状态栏图标与三键导航按钮用深色（分别需 API 23+ / API 27+） -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- 启动阶段同策略，避免进入主界面时系统栏跳色 -->
        <item name="android:statusBarColor">@color/surfaceColor</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
