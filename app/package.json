{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "capacitor-assets generate --android",
    "lint": "oxlint",
    "preview": "vite preview",
    "feishu:send-apk": "lark-cli im +messages-send --user-id ou_a8b3dfc8f689afbda1007203e93f0fbe --file android/app/build/outputs/apk/release/app-release.apk --as user",
    "release": "npm run icons && npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease && cd .. && npm run feishu:send-apk"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.126.0"
  }
}
